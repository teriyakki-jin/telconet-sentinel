    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "Current topology derived from typed node and link metrics. Edge mainstat 1 is operational; 0 is down. Node role comes from the declared intent.",
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "mappings": [
            {
              "options": {
                "-1": {"color": "gray", "text": "UNKNOWN"},
                "0": {"color": "red", "text": "DOWN"},
                "1": {"color": "green", "text": "UP"}
              },
              "type": "value"
            }
          ],
          "noValue": "UNKNOWN",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "red", "value": null},
              {"color": "green", "value": 1}
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {"h": 13, "w": 16, "x": 0, "y": 6},
      "id": 8,
      "options": {
        "edges": {"mainStatUnit": "short", "secondaryStatUnit": "short"},
        "nodes": {"mainStatUnit": "short", "secondaryStatUnit": "short"},
        "zoomMode": "cooperative"
      },
      "pluginVersion": "13.1.0",
      "targets": [
        {
          "editorMode": "code",
          "expr": "label_replace(telconet_topology_link_oper_up, \"id\", \"$1\", \"link_id\", \"(.*)\")",
          "format": "table",
          "instant": true,
          "legendFormat": "{{link_id}}",
          "range": false,
          "refId": "edges"
        },
        {
          "editorMode": "code",
          "expr": "label_replace(label_replace(label_replace(telconet_topology_node_info, \"id\", \"$1\", \"node\", \"(.*)\"), \"title\", \"$1\", \"node\", \"(.*)\"), \"subtitle\", \"$1\", \"role\", \"(.*)\")",
          "format": "table",
          "instant": true,
          "legendFormat": "{{node}}",
          "range": false,
          "refId": "nodes"
        }
      ],
      "title": "LIVE NETWORK TOPOLOGY",
      "type": "nodeGraph"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "Current selected service-prefix route and egress link. An absent route is not converted to metric zero.",
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "custom": {"cellOptions": {"type": "auto"}},
          "decimals": 0,
          "noValue": "UNKNOWN"
        },
        "overrides": [
          {
            "matcher": {"id": "byName", "options": "Metric"},
            "properties": [
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {"color": "green", "value": null},
                    {"color": "orange", "value": 100}
                  ]
                }
              },
              {"id": "custom.cellOptions", "value": {"type": "color-text"}}
            ]
          }
        ]
      },
      "gridPos": {"h": 7, "w": 8, "x": 16, "y": 6},
      "id": 9,
      "options": {
        "cellHeight": "sm",
        "footer": {"countRows": false, "enablePagination": false, "fields": "", "reducer": ["count"], "show": false},
        "showHeader": true
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "(telconet_selected_route_metric * on(node,prefix) group_left(link_id) telconet_selected_route_egress) and on(node,prefix) (telconet_selected_route_present == 1)",
          "format": "table",
          "instant": true,
          "legendFormat": "{{node}}",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "SELECTED SERVICE ROUTES",
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {"Time": true, "__name__": true, "instance": true, "job": true},
            "indexByName": {"node": 0, "prefix": 1, "link_id": 2, "Value": 3},
            "renameByName": {"Value": "Metric", "link_id": "Egress", "node": "Router", "prefix": "Prefix"}
          }
        }
      ],
      "type": "table"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
