{
  "annotations": {"list": []},
  "description": "Host-polled FRR telemetry for the local TelcoNet Sentinel containerlab. Current health, topology, routing, neighbor state, interface traffic, and drops are shown separately from sub-second convergence evidence.",
  "editable": false,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [
    {
      "asDropdown": false,
      "includeVars": false,
      "keepTime": true,
      "tags": [],
      "targetBlank": false,
      "title": "Network overview",
      "type": "link",
      "url": "/d/telconet-network-overview"
    },
    {
      "asDropdown": false,
      "includeVars": false,
      "keepTime": true,
      "tags": [],
      "targetBlank": false,
      "title": "Live convergence",
      "type": "link",
      "url": "/d/telconet-live-convergence"
    }
  ],
  "panels": [
    {
      "datasource": {"type": "datasource", "uid": "grafana"},
      "gridPos": {"h": 2, "w": 24, "x": 0, "y": 0},
      "id": 1,
      "options": {
        "code": {"language": "plaintext", "showLineNumbers": false, "showMiniMap": false},
        "content": "## Live Network Telemetry\nCurrent FRR control-plane and interface state · local containerlab simulation",
        "mode": "markdown"
      },
      "pluginVersion": "13.1.0",
      "transparent": true,
      "title": "LIVE TELEMETRY",
      "type": "text"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "Seconds since the collector produced its latest typed snapshot. Orange and red mean the last values elsewhere on this dashboard may be stale.",
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "decimals": 1,
          "noValue": "UNKNOWN",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "orange", "value": 3},
              {"color": "red", "value": 10}
            ]
          },
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {"h": 4, "w": 4, "x": 0, "y": 2},
      "id": 2,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "vertical",
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "textMode": "value_and_name",
        "wideLayout": true
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "time() - telconet_telemetry_snapshot_timestamp_seconds",
          "instant": true,
          "legendFormat": "snapshot age",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "TELEMETRY AGE",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "Routers successfully collected in the latest snapshot. Confirm TELEMETRY AGE is green before treating this count as current.",
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "decimals": 0,
          "noValue": "UNKNOWN",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "red", "value": null},
              {"color": "orange", "value": 1},
              {"color": "green", "value": 6}
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {"h": 4, "w": 4, "x": 4, "y": 2},
      "id": 3,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "vertical",
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "textMode": "value_and_name",
        "wideLayout": true
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "sum(telconet_router_collection_success)",
          "instant": true,
          "legendFormat": "routers",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "HEALTHY ROUTERS",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "Minimum state across collected OSPF neighbors. Missing series are UNKNOWN, not DOWN.",
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "mappings": [
            {
              "options": {
                "-1": {"color": "gray", "text": "UNKNOWN"},
                "0": {"color": "red", "text": "NOT FULL"},
                "1": {"color": "green", "text": "ALL FULL"}
              },
              "type": "value"
            }
          ],
          "noValue": "UNKNOWN",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "red", "value": null},
              {"color": "green", "value": 1}
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {"h": 4, "w": 4, "x": 8, "y": 2},
      "id": 4,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "vertical",
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "textMode": "value_and_name",
        "wideLayout": true
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "min(telconet_ospf_neighbor_full)",
          "instant": true,
          "legendFormat": "adjacencies",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "OSPF FULL",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "Minimum state across configured BFD peers. No configured or collected peer is shown as UNKNOWN rather than healthy.",
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "mappings": [
            {
              "options": {
                "-1": {"color": "gray", "text": "UNKNOWN"},
                "0": {"color": "red", "text": "PEER DOWN"},
                "1": {"color": "green", "text": "ALL UP"}
              },
              "type": "value"
            }
          ],
          "noValue": "UNKNOWN",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "red", "value": null},
              {"color": "green", "value": 1}
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {"h": 4, "w": 4, "x": 12, "y": 2},
      "id": 5,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "vertical",
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "textMode": "value_and_name",
        "wideLayout": true
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "min(telconet_bfd_peer_up * on(node,peer,interface) (telconet_bfd_peer_configured == 1))",
          "instant": true,
          "legendFormat": "peers",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "BFD STATUS",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "Selected OSPF metric from access1 to the service prefix. Primary is 30; the designed backup is 140.",
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "decimals": 0,
          "mappings": [
            {
              "options": {"-1": {"color": "gray", "text": "UNKNOWN"}},
              "type": "value"
            }
          ],
          "noValue": "UNKNOWN",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "orange", "value": 100}
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {"h": 4, "w": 4, "x": 16, "y": 2},
      "id": 6,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "vertical",
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "textMode": "value_and_name",
        "wideLayout": true
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "telconet_selected_route_metric{node=\"access1\"} or on() vector(-1)",
